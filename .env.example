# ===== CoopLink — mipangilio. Nakili kuwa .env (usipush .env GitHub) =====
# ---------------- DATABASE ----------------
# Local (kompyuta yako):
DATABASE_URL="postgresql://postgres:password@localhost:5432/cooplink"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cooplink"
DB_SSL=false

# Supabase (mfano):
#  DATABASE_URL = pooler (port 6543) — kwa app
#  DIRECT_URL   = direct (port 5432) — kwa migrations
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# DB_SSL=true

# ---------------- APP ----------------
NODE_ENV=development
PORT=4000
# Tengeneza kwa: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="badilisha-hii-iwe-ndefu-na-ya-siri-herufi-32-au-zaidi"
JWT_EXPIRES_IN=12h
# Tenganisha kwa koma. * = zote (development tu)
CORS_ORIGINS=*

# ---------------- SEED ----------------
SEED_ADMIN_PHONE=0700000000
SEED_ADMIN_PASSWORD=Admin12345
SEED_DEMO=false
