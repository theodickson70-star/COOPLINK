# ===== CoopLink — mipangilio. Nakili kuwa .env (usipush .env GitHub) =====
# ---------------- DATABASE ----------------
# Local (kompyuta yako):
DATABASE_URL="postgresql://postgres:password@localhost:5432/cooplink"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cooplink"
DB_SSL=false

# Supabase (mfano):
#  DATABASE_URL = pooler (port 6543) — kwa app
#  DIRECT_URL   = direct (port 5432) — kwa migrations
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# DB_SSL=true

# ---------------- APP ----------------
NODE_ENV=development
PORT=4000
# Tengeneza kwa: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="badilisha-hii-iwe-ndefu-na-ya-siri-herufi-32-au-zaidi"
JWT_EXPIRES_IN=12h
# Tenganisha kwa koma. * = zote (development tu)
CORS_ORIGINS=*

# ---------------- SEED ----------------
# SUPER_ADMIN — kwenye Railway weka hizi kwenye Variables, si hapa.
# Namba ya kuingia ya SUPER_ADMIN (lazima). Seed inabadilisha SUPER_ADMIN aliyepo, haiundi wa pili.
SEED_ADMIN_PHONE=
# Inahitajika tu kuunda SUPER_ADMIN wa kwanza, au pamoja na SEED_ADMIN_RESET_PASSWORD=true.
# Herufi 8+, iwe na herufi na namba. Ifute kwenye Railway baada ya kutumia.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_RESET_PASSWORD=false
# true = SUPER_ADMIN wengine wanazimwa (hawafutwi), abaki mmoja tu hai
SEED_ADMIN_SINGLE=false
# Tu kama kuna SUPER_ADMIN zaidi ya mmoja: namba ya sasa ya akaunti ya kubadilisha
SEED_ADMIN_FROM_PHONE=
SEED_DEMO=false

# ---------------- OWNER CONTROL PANEL (hiari) ----------------
# SMS kupitia Africa's Talking. Zikiwa tupu, SMS hazitumwi (zinarekodiwa kama SKIPPED).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# true = zima kazi ya kila saa ya subscriptions (kwa majaribio tu)
DISABLE_JOBS=false
