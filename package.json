{
  "name": "cooplink",
  "version": "0.1.0",
  "description": "CoopLink - mfumo wa kisasa wa kusimamia vyama vya msingi (AMCOS): backend + admin web",
  "main": "dist/server.js",
  "scripts": {
    "setup": "npm install && npm --prefix admin install",
    "dev": "tsx watch src/server.ts",
    "dev:admin": "npm --prefix admin run dev",
    "build": "npm run build:api && npm run build:admin",
    "build:api": "tsc",
    "build:admin": "npm --prefix admin ci --include=dev && npm --prefix admin run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && npm --prefix admin run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:prod": "node dist/db/seed.js",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test test/*.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=20"
  }
}
